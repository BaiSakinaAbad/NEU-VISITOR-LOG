/**
 * Core Philosophy: This ruleset implements a robust security model based on user ownership and a global admin role.
 * Standard users have full control over their own data and associated subcollections, while administrators have
 * overarching read and management permissions across the system. The default security posture is to deny all access
 * unless explicitly granted.
 *
 * Data Structure:
 * - /users/{userId}: Contains user profile data. Each user can manage their own profile. The 'role' field in this document determines admin status.
 * - /users/{userId}/visits/{visitId}: A subcollection logging each visit a user makes. It is owned by the parent user.
 * - /visit_purposes/{purposeId}: A globally readable collection of predefined reasons for a library visit. Writable only by admins.
 *
 * Key Security Decisions:
 * - Admin Role Management: Administrator status is determined by reading the 'role' field from the requesting user's
 *   own profile document (`/users/{uid}`). This is secure because users only have read access to their own document.
 *   **IMPORTANT: For a user to become an admin, their 'role' field in the '/users/{uid}' document MUST be manually set to 'admin' in the Firebase Console.**
 * - User Data Scoping: All user-specific data is nested under `/users/{userId}`, allowing rules to use the `{userId}`
 *   wildcard to enforce strict data ownership without needing extra database reads.
 * - No User Listing: Non-admin users are explicitly forbidden from listing the `/users` collection to protect user privacy.
 * - Public Data Segregation: Publicly readable data (like visit purposes) is stored in a separate top-level
 *   collection, which is more secure and performant for list operations than mixing public and private data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user has admin privileges.
     * Admin status is granted if the 'role' field in their user document is 'admin'.
     *
     * This function will return false if the user document does not exist or if the 'role' field is not 'admin'.
     *
     * To grant admin privileges:
     * 1. Go to the Firebase Console -> Firestore Database.
     * 2. In the 'users' collection, find the document with the user's UID.
     * 3. Set the 'role' field to the string value 'admin'.
     */
    function isAdmin() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn()
          && exists(userDocPath)
          && get(userDocPath).data.role == 'admin';
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the primary mechanism for verifying data ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Validates the required fields for a new user document on creation.
     * Ensures path integrity and prevents users from assigning themselves elevated privileges.
     */
    function hasValidInitialUserData(userId) {
      let data = request.resource.data;
      return data.id == userId
          && data.role == 'user'
          && data.isBlocked == false;
    }

    /**
     * Validates that an owner is only updating their own non-privileged fields.
     * Prevents a user from changing their own role or un-blocking themselves.
     */
    function isOwnerUpdatingAllowedFields() {
      return request.resource.data.role == resource.data.role
          && request.resource.data.isBlocked == resource.data.isBlocked;
    }

    /**
     * Validates the required fields for a new visit document on creation.
     * Enforces the relationship between the visit and the user in the path.
     */
    function hasValidVisitData(userId) {
      return request.resource.data.userId == userId;
    }

    // --------------------------------------------------------------------
    // Collection Group Rules
    // --------------------------------------------------------------------

    /**
     * @description Enables admin-only collection group queries on 'visits'.
     * @path /{path=**}/visits/{visitId}
     * @allow (get, list) An admin reading any visit for analytics or management.
     * @principle Grants broad read access to a specific collection group for a privileged role.
     */
    match /{path=**}/visits/{visitId} {
      allow get, list: if isAdmin();
    }
    

    // --------------------------------------------------------------------
    // User Profiles
    // --------------------------------------------------------------------

    match /users/{userId} {
      // An authenticated user can create their own document.
      allow create: if isOwner(userId) && hasValidInitialUserData(userId);

      // A user can read, update, and delete their own document.
      // This rule is separated to break the circular dependency with isAdmin().
      allow get, delete: if isOwner(userId);
      allow update: if isOwner(userId) && isOwnerUpdatingAllowedFields();
      
      // An admin can read, list, update, and delete any user document.
      allow get, list, update, delete: if isAdmin();

      // --------------------------------------------------------------------
      // User Visits Subcollection
      // --------------------------------------------------------------------
      match /visits/{visitId} {
        allow create: if isOwner(userId) && hasValidVisitData(userId);
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow update: if isOwner(userId) && request.resource.data.userId == resource.data.userId && resource != null;
        allow delete: if isOwner(userId) && resource != null;
      }
    }

    // --------------------------------------------------------------------
    // Visit Purposes (Public Reference Data)
    // --------------------------------------------------------------------

    match /visit_purposes/{purposeId} {
      allow get, list: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin() && resource != null;
    }
  }
}
